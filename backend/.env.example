# Environment
NODE_ENV=production

# Server
PORT=5000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=navasetu_assessment
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Razorpay (Optional for MVP)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gmail (Optional for MVP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# File Storage (MinIO - Optional for MVP)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=navasetu-reports

# Logging
LOG_LEVEL=info
